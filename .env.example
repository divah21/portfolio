# --- CV download alerts (Resend) ---
# 1. Sign up at https://resend.com (free), create an API key, paste it here.
RESEND_API_KEY=

# Where download alert emails are sent (defaults to your address if unset).
CV_ALERT_TO=david.smart@fluencetraining.com

# The "from" address. Until you verify your own domain in Resend, leave this as the
# Resend test sender below. Once your domain is verified, use e.g. "CV <cv@yourdomain.com>".
CV_ALERT_FROM=CV Downloads <onboarding@resend.dev>
